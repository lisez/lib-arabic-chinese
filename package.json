{
  "name": "lib-arabic-chinese",
  "version": "3.0.0-rc.1",
  "private": false,
  "description": "A library for converting from Arabic numbers to Chinese numbers",
  "keywords": [
    "arabic",
    "arabic-number",
    "chinese",
    "chinese-number",
    "converter",
    "javascript",
    "number",
    "numeral",
    "typescript"
  ],
  "homepage": "https://github.com/lisez/lib-arabic-chinese",
  "bugs": {
    "url": "https://github.com/lisez/lib-arabic-chinese/issues"
  },
  "license": "MIT",
  "author": "lisez <sujingjhong@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git@github.com:lisez/lib-arabic-chinese.git"
  },
  "files": [
    "dist",
    "*.d.ts"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "scripts": {
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-types.mjs",
    "bundle": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "npm run build && vitest",
    "prepare": "npm run build",
    "demo": "tsx ./demo/index.ts",
    "verify:package": "npm run build && tsx scripts/check-package.mts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
